# Dependencies
node_modules
.pnpm-store

# This project uses pnpm (pnpm-lock.yaml is the authoritative lockfile — see
# docs/DEVELOPER_SETUP.md). Vercel selects its package manager by detecting the
# lockfile, so committing a second one would make the production build's
# dependency resolution ambiguous. Ignored rather than deleted so an accidental
# `npm install` cannot change how production is built.
package-lock.json
yarn.lock

# Next.js
.next
out
build

# Environment — see the authoritative rules at the end of this file.

# Prisma
prisma/generated

# Vercel
.vercel

# Testing
coverage

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Misc
*.tsbuildinfo
next-env.d.ts
.vercel

# --- Environment (MUST stay last) --------------------------------------------
# Git applies the LAST matching pattern, so these negations have to come after
# every other .env rule — including the `.env*` line the Vercel CLI appends on
# `vercel link`, which would otherwise re-ignore the committed templates.
.env*
!.env.example
!.env.*.example
