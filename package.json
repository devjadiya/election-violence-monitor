    "next-auth": "^5.0.0-beta.30",
    "node-html-parser": "^7.1.0",
    "papaparse": "^5.5.3",
    "prisma": "^5.22.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
