# =============================================================================
# Election Violence Monitor — environment template
# =============================================================================
# Copy to .env.local and fill in. NEVER commit a file containing real values.
#   cp .env.example .env.local
#
# Verify what you have set (prints names and status only, never values):
#   npm run check:env
#
# Legend:  [REQUIRED] app will not work without it
#          [OPTIONAL] feature-specific; app runs without it
#          [PUBLIC]   NEXT_PUBLIC_* — shipped to the browser, treat as world-readable
#          [SECRET]   server-only — never prefix with NEXT_PUBLIC_
#
# See docs/DEVELOPER_SETUP.md for how to obtain each value.
# =============================================================================


# --- Public application config ------------------------------------ [PUBLIC] -
# Safe to expose. These are compiled into the client bundle.

# [REQUIRED] Base URL of this deployment. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# [OPTIONAL] Display name shown in the UI.
NEXT_PUBLIC_APP_NAME=


# --- Database ----------------------------------------------------- [SECRET] -

# [REQUIRED] Pooled connection, used by the application at runtime.
# Supabase: Project Settings -> Database -> Connection string -> Transaction pooler.
# Must include ?pgbouncer=true&connection_limit=1 for serverless.
DATABASE_URL=

# [REQUIRED for migrations] Direct (non-pooled) connection, port 5432.
# Prisma migrations MUST NOT run through the transaction pooler.
# Not yet referenced by schema.prisma — see docs/PRODUCTION_SAFETY.md (finding D10).
DIRECT_URL=


# --- Authentication ----------------------------------------------- [SECRET] -

# [REQUIRED] Signing secret for NextAuth v5. Generate a fresh one per environment:
#   openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is the v4 name kept for compatibility.
# Set both to the same value if you are unsure which the runtime picks up.
AUTH_SECRET=
NEXTAUTH_SECRET=

# [REQUIRED] Canonical URL NextAuth issues callbacks against.
# Local: http://localhost:3000
NEXTAUTH_URL=


# --- AI provider -------------------------------------------------- [SECRET] -

# [REQUIRED for ingestion] Read implicitly by @ai-sdk/google — it never appears
# as process.env.* in our source, which makes it easy to miss when provisioning.
# Obtain from https://aistudio.google.com/apikey (free tier available).
GOOGLE_GENERATIVE_AI_API_KEY=


# --- Cache / rate limiting / dedup --------------------------------- [SECRET] -

# [REQUIRED] Upstash Redis REST credentials.
# Upstash console -> your database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Job queue (planned — Step 14) --------------------------------- [SECRET] -
# Not yet referenced in application code. Present so the deployed environment
# and this template stay in sync. See docs/TECHNICAL_BLUEPRINT.md ADR 029.

QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=


# --- Scheduled ingestion ------------------------------------------ [SECRET] -

# [REQUIRED for cron] Bearer token guarding /api/cron/ingest.
# Generate: openssl rand -base64 24
CRON_SECRET=


# --- Operations --------------------------------------------------- [SECRET] -

# [OPTIONAL] Address that receives operational alerts.
ADMIN_EMAIL=


# --- Currently unused --------------------------------------------------------
# Present in the deployed environment but referenced NOWHERE in application code
# (verified by grep across src/ and prisma/). Listed so the drift is visible.
# Candidates for removal — see docs/DEVELOPER_SETUP.md "Unused variables".

# [OPTIONAL] Supabase JS client credentials. The @supabase/* packages are
# installed but never imported; Prisma talks to Postgres directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [SECRET][UNUSED] Bypasses ALL Supabase row-level security. Nothing reads it.
# Strongly consider deleting this from the deployment rather than rotating it.
SUPABASE_SERVICE_ROLE_KEY=

# [OPTIONAL][UNUSED] No NewsAPI integration exists in the codebase.
NEWSAPI_KEY=

# [OPTIONAL][UNUSED] Sentry is installed but has no configuration files.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
